// Generated by CMake from resources/app/mirante.rc.in. Do not edit.
// The icon of mirante.exe on Windows, and the version that its properties and
// the setup show. The windows use resources/icons/mirante.svg.
#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/resources/app/mirante.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Rangel Reale"
            VALUE "FileDescription", "Mirante"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "mirante"
            VALUE "LegalCopyright", "Copyright (c) 2026 Rangel Reale"
            VALUE "OriginalFilename", "mirante.exe"
            VALUE "ProductName", "Mirante"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
